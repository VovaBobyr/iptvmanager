{
  "name": "IPTV Manager",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "IPTV Manager",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "containerEnv": {
    "IPTV_DATABASE_URL": "sqlite:///./data/iptv.db",
    "IPTV_FFPROBE_ENABLED": "true"
  },
  "postCreateCommand": "pip install -e '.[dev]'",
  "postStartCommand": "bash .devcontainer/start-app.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  }
}
