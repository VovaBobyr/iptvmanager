IPTV_DATABASE_URL=sqlite:///./data/iptv.db
IPTV_REQUEST_TIMEOUT_SECONDS=10
IPTV_HEALTH_CONCURRENCY=12
IPTV_HEALTH_RETRIES=1
IPTV_FFPROBE_ENABLED=true
